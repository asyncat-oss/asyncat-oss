# Dependencies
node_modules/

# Environment variables (den/.env and neko/.env are created from .env.example on install)
.env
.env.local
.env.*.local
.env.dev
*.local

# Build output
dist/
release/
/build/*
!/build/installer.nsh

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data directories (user data, uploads, logs, MCP config)
data/
logs/

# SQLite database files (belt-and-suspenders)
*.db
*.db-shm
*.db-wal

# Asyncat workspace data
.asyncat/
.asyncat-attachments/
.asyncat-artifacts/
.agent_tmp/

# nodemon restart trigger (den/nodemon.json watches this file)
den/.restart

# Local AI model files (large binaries — download separately)
**/*.gguf
**/*.ggml
**/*.bin

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db

# Editors
**/.vscode/*
!**/.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code
.claude/

# Bundled Node.js binary and download cache (generated by scripts/bundle-node.js at build time)
resources/node-bin/
.node-bundle-cache/
.electron-cache/
.electron-builder-cache/
